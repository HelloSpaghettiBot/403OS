+      return pad_expression + " | " +
+             ciface::MappingCommon::GetExpressionForControl(key, keyboard, gamepad);
+    };
+    const auto keyboard_expression = [&](const char* key) {
+      return keyboard.source.empty() ? std::string{} :
+             ciface::MappingCommon::GetExpressionForControl(key, keyboard, gamepad);
+    };
+
+    const std::array<const char*, 6> buttons = {
