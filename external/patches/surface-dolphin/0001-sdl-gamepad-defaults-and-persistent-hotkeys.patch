+void InputConfig::SaveSurfaceDefaultsIfAbsent()
+{
+#ifdef __linux__
+  if ((m_ini_name != "GCPadNew" && m_ini_name != "Hotkeys") || m_controllers.empty())
+    return;
+  const std::string filename = File::GetUserPath(D_CONFIG_IDX) + m_ini_name + ".ini";
+  if (File::Exists(filename))
+    return;
+  // Keep keyboard-only defaults ephemeral so a later first gamepad can bind
+  // automatically. Once saved, every user profile remains authoritative.
+  if (m_ini_name == "GCPadNew" && m_controllers[0]->GetDefaultDevice().source != "SDL")
+    return;
+
+  Common::IniFile defaults;
+  for (auto& controller : m_controllers)
+    controller->SaveConfig(defaults.GetOrCreateSection(controller->GetName()));
+  std::string pattern = filename + ".surface-XXXXXX";
+  std::vector<char> temporary(pattern.begin(), pattern.end());
+  temporary.push_back('\0');
+  const int fd = ::mkstemp(temporary.data());
+  if (fd < 0)
+    return;
+  ::close(fd);
+  if (defaults.Save(temporary.data()) && ::link(temporary.data(), filename.c_str()) == 0)
+  {
+    // link publishes atomically and fails if a user file/symlink appeared.
+    const int directory = ::open(File::GetUserPath(D_CONFIG_IDX).c_str(), O_RDONLY | O_DIRECTORY);
+    if (directory >= 0)
+    {
+      ::fsync(directory);
+      ::close(directory);
+    }
+  }
+  File::Delete(temporary.data());
+#endif
 }
 
