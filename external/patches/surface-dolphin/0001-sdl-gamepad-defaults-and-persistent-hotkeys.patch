+      m_buttons->SetControlExpression(i, expression(buttons[i], button_keys[i]));
+
+    const std::array<const char*, 4> main_axes = {"Left Y+", "Left Y-", "Left X-", "Left X+"};
+    const std::array<const char*, 4> main_keys = {"Up", "Down", "Left", "Right"};
+    const std::array<const char*, 4> c_axes = {"Right Y+", "Right Y-", "Right X-", "Right X+"};
+    const std::array<const char*, 4> c_keys = {"I", "K", "J", "L"};
+    const std::array<const char*, 4> pad_buttons = {"Pad N", "Pad S", "Pad W", "Pad E"};
+    const std::array<const char*, 4> pad_keys = {"T", "G", "F", "H"};
+    for (std::size_t i = 0; i < main_axes.size(); ++i)
+    {
+      m_main_stick->SetControlExpression(i, expression(main_axes[i], main_keys[i]));
+      m_c_stick->SetControlExpression(i, expression(c_axes[i], c_keys[i]));
+      m_dpad->SetControlExpression(i, expression(pad_buttons[i], pad_keys[i]));
+    }
+    m_main_stick->SetControlExpression(4, keyboard_expression("Shift"));
+    m_c_stick->SetControlExpression(4, keyboard_expression("Ctrl"));
+    m_main_stick->SetCalibrationFromGate(ControllerEmu::RoundStickGate(1.0));
+    m_c_stick->SetCalibrationFromGate(ControllerEmu::RoundStickGate(1.0));
+    m_triggers->SetControlExpression(0, expression("Trigger L", "Q"));
+    m_triggers->SetControlExpression(1, expression("Trigger R", "W"));
+    m_triggers->SetControlExpression(2, expression("Trigger L", "Q"));
+    m_triggers->SetControlExpression(3, expression("Trigger R", "W"));
+    m_rumble->SetControlExpression(0, "`Motor L` | `Motor R`");
+    m_triforce->SetControlExpression(0, keyboard_expression("1"));
+    m_triforce->SetControlExpression(1, keyboard_expression("2"));
+    m_triforce->SetControlExpression(2, keyboard_expression("3"));
+    break;
