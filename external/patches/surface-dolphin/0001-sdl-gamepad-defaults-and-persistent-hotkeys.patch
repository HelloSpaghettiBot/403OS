+    if (device->GetSource() != "SDL" || !device->FindInput("Button A") ||
+        !device->FindInput("Left X+") || !device->FindInput("Left Y+") ||
+        !device->FindInput("Right X+") || !device->FindInput("Right Y+"))
+      continue;
+
+    ciface::Core::DeviceQualifier gamepad;
+    gamepad.FromDevice(device.get());
+    SetDefaultDevice(gamepad);
+    const auto expression = [&](const char* pad, const char* key) {
+      const auto pad_expression = ciface::MappingCommon::GetExpressionForControl(pad, gamepad, gamepad);
+      if (keyboard.source.empty())
