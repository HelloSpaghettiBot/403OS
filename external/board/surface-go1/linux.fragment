CONFIG_EFI_PARTITION=y
# Optical installer: a small initramfs mounts read-only media and prepares a
# bounded writable overlay. Installed/USB images retain their direct GPT boot.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_OVERLAY_FS=y
CONFIG_ISO9660_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_JOLIET=y
CONFIG_BLK_DEV_SR=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_HID_MULTITOUCH=y
CONFIG_HID_MICROSOFT=y
CONFIG_HID_SENSOR_HUB=y
CONFIG_I2C_HID_ACPI=y
# The HID child needs its Kaby Lake LPSS I2C controller and GPIO interrupts.
CONFIG_X86_INTEL_LPSS=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_I2C=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_I2C_DESIGNWARE_PCI=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_SUNRISEPOINT=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_SURFACE3_SPI=m
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_SDHCI_ACPI=y
CONFIG_BLK_DEV_NVME=y
CONFIG_SATA_AHCI=y
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
# Firmware lives on the real rootfs, with no firmware-bearing initramfs.
# Probe only after that filesystem is mounted, as Ubuntu/Pop!_OS do.
CONFIG_BT_HCIBTUSB=m
# Keep USB Bluetooth awake by default on the Surface Go.
# CONFIG_BT_HCIBTUSB_AUTOSUSPEND is not set
# Classic HID and BlueZ's user-space HID/HOG path are both used by gamepads.
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HIDP=y
CONFIG_UHID=y
CONFIG_HIDRAW=y
CONFIG_RFKILL=y
# BlueZ uses AF_ALG for AES encryption and CMAC, including LE identity keys
# and signed attributes. Algorithms alone do not expose the user-space API.
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
# BlueZ's current AF_ALG client still requests ECB and CMAC explicitly.
CONFIG_CRYPTO_USER_API_ENABLE_OBSOLETE=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CMAC=y
CONFIG_MWIFIEX=m
CONFIG_MWIFIEX_PCIE=m
CONFIG_BATTERY_SURFACE=m
CONFIG_SURFACE_GPE=m
CONFIG_SURFACE_AGGREGATOR=m
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_AC=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_INPUT_JOYDEV=y
CONFIG_JOYSTICK_XPAD=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_HID_SONY=y
CONFIG_HID_NINTENDO=y
CONFIG_HID_PLAYSTATION=y
CONFIG_USB_HID=y
CONFIG_USB_HIDDEV=y
CONFIG_DEVPTS_MULTIPLE_INSTANCES=y
CONFIG_UNIX98_PTYS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_USER_NS=y
CONFIG_TUN=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NTFS3_FS=y
CONFIG_NLS_UTF8=y

# First-generation Surface Go Intel HD615/QCA6174/HDA baseline.
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_FW_LOADER=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_IA32_EMULATION=y

# Expose real HID accelerometer samples through IIO for display rotation.
CONFIG_INTEL_ISH_HID=y
CONFIG_IIO=y
CONFIG_IIO_BUFFER=y
CONFIG_HID_SENSOR_IIO_COMMON=y
CONFIG_HID_SENSOR_IIO_TRIGGER=y
CONFIG_HID_SENSOR_ACCEL_3D=y
CONFIG_INPUT_MISC=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_SOC_BUTTON_ARRAY=y
CONFIG_INTEL_HID_EVENT=y

# Broad upstream USB/Bluetooth gamepad, arcade-adapter and wheel coverage.
CONFIG_HID_ACRUX=y
CONFIG_HID_ACRUX_FF=y
CONFIG_HID_BETOP_FF=y
CONFIG_HID_BIGBEN_FF=y
CONFIG_HID_DRAGONRISE=y
CONFIG_HID_EMS_FF=y
CONFIG_HID_GEMBIRD=y
CONFIG_HID_GOOGLE_STADIA_FF=y
CONFIG_HID_HOLTEK=y
CONFIG_HID_ICADE=y
CONFIG_HID_LOGITECH=y
CONFIG_HID_LOGITECH_DJ=y
CONFIG_HID_LOGITECH_HIDPP=y
CONFIG_HID_MAYFLASH=y
CONFIG_HID_MEGAWORLD_FF=y
CONFIG_HID_NVIDIA_SHIELD=y
CONFIG_HID_PANTHERLORD=y
CONFIG_HID_PXRC=y
CONFIG_HID_RETRODE=y
CONFIG_HID_SAITEK=y
CONFIG_HID_SPEEDLINK=y
CONFIG_HID_STEAM=y
CONFIG_HID_STEELSERIES=y
CONFIG_HID_GREENASIA=y
CONFIG_HID_SMARTJOYPLUS=y
CONFIG_HID_THRUSTMASTER=y
CONFIG_HID_UDRAW_PS3=y
CONFIG_HID_PID=y
CONFIG_HID_UNIVERSAL_PIDFF=y
CONFIG_HID_WIIMOTE=y
CONFIG_HID_WINWING=y
CONFIG_HID_XINMO=y
CONFIG_HID_ZEROPLUS=y
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_JOYSTICK_PXRC=y
