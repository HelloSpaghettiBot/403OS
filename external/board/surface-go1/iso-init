#!/bin/sh
# 403 OS optical live boot. This runs only from the dedicated ISO initramfs.
# No physical storage is opened writable; volatile changes live in bounded RAM.
set -eu
export PATH=/sbin:/bin
export LC_ALL=C
umask 077

fail() {
    echo "SURFACE_ISO_BOOT_FAIL: $*" >/dev/console
    echo 'The installer could not start. Power off; no internal disk was changed.' >/dev/console
    while :; do sleep 3600; done
}
trap 'fail "An early boot operation failed"' EXIT

mkdir -p /dev /proc /sys /run /newroot
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
set -f
set -- $(cat /proc/cmdline)
set +f
iso_boot=0
iso_label=0
for token do
    case "$token" in
        surface.boot=iso) iso_boot=$((iso_boot + 1));;
        surface.iso=403OS_LIVE) iso_label=$((iso_label + 1));;
        surface.boot=*|surface.iso=*) fail 'Unexpected optical boot parameters';;
    esac
done
[ "$iso_boot" = 1 ] && [ "$iso_label" = 1 ] || fail 'Explicit optical boot parameters are required'

ROOT_OFFSET= ROOT_BYTES= IMAGE_BYTES= IMAGE_SHA256=
while IFS='=' read -r key value; do
    case "$key" in
        ROOT_OFFSET) [ -z "$ROOT_OFFSET" ] || fail 'Duplicate layout field'; ROOT_OFFSET=$value;;
        ROOT_BYTES) [ -z "$ROOT_BYTES" ] || fail 'Duplicate layout field'; ROOT_BYTES=$value;;
        IMAGE_BYTES) [ -z "$IMAGE_BYTES" ] || fail 'Duplicate layout field'; IMAGE_BYTES=$value;;
        IMAGE_SHA256) [ -z "$IMAGE_SHA256" ] || fail 'Duplicate layout field'; IMAGE_SHA256=$value;;
        *) fail 'Unsupported optical layout metadata';;
    esac
done </etc/surface-iso-layout
for number in "$ROOT_OFFSET" "$ROOT_BYTES" "$IMAGE_BYTES"; do
    case "$number" in ''|*[!0-9]*) fail 'Invalid optical image geometry';; esac
    [ "${#number}" -le 12 ] || fail 'Optical image geometry is too large'
done
[ "$ROOT_OFFSET" -ge 1048576 ] && [ "$ROOT_BYTES" -gt 0 ] &&
    [ "$((ROOT_OFFSET % 512))" = 0 ] && [ "$((ROOT_BYTES % 512))" = 0 ] &&
    [ "$((ROOT_OFFSET + ROOT_BYTES))" -lt "$IMAGE_BYTES" ] || fail 'Invalid optical root partition range'
case "$IMAGE_SHA256" in ''|*[!0-9a-f]*) fail 'Invalid optical image checksum';; esac
[ "${#IMAGE_SHA256}" = 64 ] || fail 'Invalid optical image checksum length'

# Keep /run mounted across switch_root. Unlike ramfs, tmpfs enforces this bound.
mount -t tmpfs -o size=1536m,mode=0755,nosuid,nodev tmpfs /run
work=/run/surface-iso
mkdir -p "$work/media" "$work/payload" "$work/lower" "$work/upper" "$work/work"
chmod 700 "$work"
cp /etc/surface-iso-layout "$work/layout"
chmod 400 "$work/layout"

media=
attempt=0
while [ -z "$media" ] && [ "$attempt" -lt 30 ]; do
    for sysdev in /sys/class/block/*; do
        [ -f "$sysdev/dev" ] || continue
        device=/dev/${sysdev##*/}
        [ -b "$device" ] || continue
        label=$(/sbin/blkid -p -s LABEL -o value "$device" 2>/dev/null || true)
        [ "$label" = 403OS_LIVE ] || continue
        [ -z "$media" ] || fail 'More than one optical installer is connected'
        media=$device
    done
    [ -n "$media" ] || sleep 1
    attempt=$((attempt + 1))
done
[ -n "$media" ] || fail 'The optical installer medium was not found'
mount -t iso9660 -o ro,nosuid,nodev,noexec "$media" "$work/media"
payload_loop=$(losetup -f)
losetup -r "$payload_loop" "$work/media/403os/payload.squashfs"
mount -t squashfs -o ro,nosuid,nodev "$payload_loop" "$work/payload"
image=$work/payload/SurfaceGoGamingOS/surface-go.img
[ "$(cat "$image.sha256")" = "$IMAGE_SHA256  surface-go.img" ] || fail 'Installer checksum metadata differs from the boot image'
echo '403 OS: checking the installer image...' >/dev/console
printf '%s  %s\n' "$IMAGE_SHA256" "$image" | sha256sum -c - >/dev/null || fail 'Installer image checksum failed'
image_loop=$(losetup -f)
losetup -r -P "$image_loop" "$image"
[ "$(cat "/sys/class/block/${image_loop##*/}/size")" = "$((IMAGE_BYTES / 512))" ] || fail 'The installation image size differs from its boot layout'
root_device=${image_loop}p2
attempt=0
while [ ! -b "$root_device" ] && [ "$attempt" -lt 50 ]; do
    sleep .1
    attempt=$((attempt + 1))
done
[ -b "$root_device" ] || fail 'The installer root partition was not found'
root_sys=/sys/class/block/${root_device##*/}
[ "$(cat "$root_sys/start")" = "$((ROOT_OFFSET / 512))" ] &&
    [ "$(cat "$root_sys/size")" = "$((ROOT_BYTES / 512))" ] || fail 'The root partition differs from the boot layout'
mount -t ext4 -o ro,noload "$root_device" "$work/lower"
mount -t overlay overlay -o "lowerdir=$work/lower,upperdir=$work/upper,workdir=$work/work" /newroot

# Four GiB is the filesystem's logical capacity, not a RAM allocation. Disable
# its journal; sparse unwritten blocks consume no tmpfs pages and all state is
# deliberately temporary. The shared /run tmpfs imposes the real 1536 MiB cap.
truncate -s 4294967296 "$work/live-data.ext4"
/sbin/mke2fs -q -F -t ext4 -L SURFACE_DATA -m 0 -O '^has_journal' \
    -E nodiscard,lazy_itable_init=1 "$work/live-data.ext4"
chmod 600 "$work/live-data.ext4"
data_loop=$(losetup -f)
losetup "$data_loop" "$work/live-data.ext4"
mount -t ext4 -o rw "$data_loop" /newroot/data
mkdir -p /newroot/data/SurfaceGoGamingOS
mount -o bind "$work/payload/SurfaceGoGamingOS" /newroot/data/SurfaceGoGamingOS
mount -o remount,bind,ro /newroot/data/SurfaceGoGamingOS

# mount -a in the ordinary init must not cover these live mounts. Only this
# ephemeral overlay is changed; the pristine installation payload stays intact.
awk '$2 != "/run" && $2 != "/proc" && $2 != "/sys" { print }' \
    /newroot/etc/fstab >/newroot/etc/fstab.iso
mv /newroot/etc/fstab.iso /newroot/etc/fstab
chmod 644 /newroot/etc/fstab
sed '/^::sysinit:\/bin\/mount -t proc proc \/proc$/d' /newroot/etc/inittab >/newroot/etc/inittab.iso
mv /newroot/etc/inittab.iso /newroot/etc/inittab
chmod 644 /newroot/etc/inittab
mount -o move /run /newroot/run
mount -o move /proc /newroot/proc
mount -o move /sys /newroot/sys
mount -o move /dev /newroot/dev
# Restore the ordinary boot default for services. Private runtime paths above
# have explicit restrictive modes; inheriting 077 would hide shared state.
umask 022
trap - EXIT
exec switch_root /newroot /sbin/init
