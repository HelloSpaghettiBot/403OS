#!/bin/sh
set -u
export XDG_RUNTIME_DIR=/run/surface
export WAYLAND_DISPLAY=wayland-0
export DISPLAY=:0
export SDL_VIDEO_DRIVER=wayland
export SDL_VIDEODRIVER=wayland
export SDL_GAMECONTROLLERCONFIG_FILE=/data/config/gamecontrollerdb.txt
export LIBSEAT_BACKEND=builtin
export HOME=/data/home
export XDG_CONFIG_HOME=/data/config
export XDG_CACHE_HOME=/data/cache
export XDG_DATA_HOME=/data/share
export SURFACE_LIBRARY=/data/library/catalog.tsv
if test -f /library/index/catalog.tsv; then export SURFACE_LIBRARY=/library/index/catalog.tsv; fi
graphics=pixman
for driver in /sys/class/drm/card*/device/driver; do
    if test "$(basename "$(readlink -f "$driver")")" = i915; then graphics=gl;export LIBVA_DRIVER_NAME=iHD;fi
done
# Xwayland binds its Unix socket before Weston finishes starting.
test ! -L /tmp/.X11-unix || exit 1
mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix || exit 1
chvt 1
exec /usr/sbin/surface-display --session --renderer "$graphics"
