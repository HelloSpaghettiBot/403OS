#!/usr/bin/python3
"""Bounded acceptance checks for the booted OS; never launches host desktop apps.

Runtime passes are deliberately separate from live enrollment, streaming,
audibility and physical Surface validation. This helper never calls tailscale
up/login or contacts a Sunshine host. Root VM automation captures the browser
while SURFACE_BROWSER_DISPLAY_READY is displayed, then observes HOME return afterward.
"""
import argparse
import collections
import hashlib
import http.server
import json
import math
import os
import pwd
from pathlib import Path
import re
import secrets
import signal
import shutil
import socket
import stat
import struct
import subprocess
import threading
import tempfile
import time
import urllib.parse
import wave

IMAGE_MARKER=Path('/etc/surface-image-id')
STATE_FILE=Path('/data/tailscale/tailscaled.state')
ALLOWED_BACKENDS={'NoState','NeedsLogin','NeedsMachineAuth','Stopped','Starting','Running'}
VM_DMI=Path('/sys/class/dmi/id/product_name')
TEST_OPTIONS=Path('/run/surface-test-options')
MOUNT_INFO=Path('/proc/self/mountinfo')
VM_NAME='Surface Go OS Disposable Test VM'
INSTALLER_PAYLOAD=Path('/data/SurfaceGoGamingOS/surface-go.img')
ROTATION_MODULE=Path('/usr/lib/weston/surface-rotation.so')
ROTATION_SOCKET=Path('/run/surface/display/rotation.sock')
DISPLAY_STATE=(Path('/data/config/display.json'),Path('/run/surface/display/pending.json'),Path('/data/config/rotation.json'))


def emit(marker,**fields):
    print(marker+' '+ ' '.join(f'{key}={str(value).replace(" ","_")}' for key,value in fields.items()),flush=True)


def private_json(path,value):
    path.parent.mkdir(parents=True,exist_ok=True,mode=0o700)
    temporary=path.with_name(path.name+'.tmp-'+str(os.getpid()))
    fd=os.open(temporary,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
    try:
        with os.fdopen(fd,'w') as output:
            json.dump(value,output,indent=2);output.write('\n');output.flush();os.fsync(output.fileno())
        os.replace(temporary,path)
    finally:
        temporary.unlink(missing_ok=True)


def guard():
    if not IMAGE_MARKER.is_file():
        raise RuntimeError('requires the booted Surface OS image marker')
    if not any(line.split()[1]=='/data' for line in Path('/proc/mounts').read_text().splitlines() if len(line.split())>2):
        raise RuntimeError('requires the separate persistent /data mount')


def stop_group(process,grace=5):
    if process.poll() is None:
        try:os.killpg(process.pid,signal.SIGTERM)
        except ProcessLookupError:pass
    try:return process.wait(timeout=grace)
    except subprocess.TimeoutExpired:
        try:os.killpg(process.pid,signal.SIGKILL)
        except ProcessLookupError:pass
        return process.wait(timeout=2)


def command(argv,log,timeout=10,env=None,tail=False,user=None):
    credentials={}
    if user is not None:
        account=pwd.getpwnam(user)
        credentials=dict(user=account.pw_uid,group=account.pw_gid,
                         extra_groups=os.getgrouplist(user,account.pw_gid))
    with log.open('wb') as output:
        process=subprocess.Popen(argv,stdin=subprocess.DEVNULL,stdout=output,stderr=subprocess.STDOUT,
                                 env=env,start_new_session=True,**credentials)
        try:code=process.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            stop_group(process);raise RuntimeError('command exceeded its time limit')
    with log.open('rb') as output:
        if tail:output.seek(max(0,os.fstat(output.fileno()).st_size-256*1024))
        text=output.read(256*1024).decode(errors='replace')
    return code,text


def vm_test_options():
    """Read only a fixed, bounded request on the exact VM's read-only 9p share."""
    try:product=VM_DMI.read_text().strip()
    except OSError:return {'test_proton':False,'test_ipega':False}
    if product!=VM_NAME:return {'test_proton':False,'test_ipega':False}  # Never inspect test requests on hardware.
    mounted=False
    for line in MOUNT_INFO.read_text().splitlines():
        fields=line.split()
        if len(fields)<10 or '-' not in fields:continue
        point=re.sub(r'\\([0-7]{3})',lambda value:chr(int(value[1],8)),fields[4])
        if point!=str(TEST_OPTIONS):continue
        split=fields.index('-')
        if split+3>=len(fields):raise RuntimeError('test options mount metadata is incomplete')
        if fields[3]!='/' or fields[split+1:split+3]!=['9p','surface_test_options'] or not {'ro','noexec','nosuid','nodev'}<=set(fields[5].split(',')) or 'ro' not in fields[split+3].split(','):
            raise RuntimeError('test options must be the read-only, noexec surface_test_options 9p share')
        if mounted:raise RuntimeError('test options mount is ambiguous')
        mounted=True
    if not mounted:return {'test_proton':False,'test_ipega':False}
    directory=os.open(TEST_OPTIONS,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW|os.O_CLOEXEC)
    try:
        if not os.fstatvfs(directory).f_flag&os.ST_RDONLY:
            raise RuntimeError('test options filesystem is not read only')
        descriptor=os.open('request.json',os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK|os.O_CLOEXEC,dir_fd=directory)
        with os.fdopen(descriptor,'rb') as source:
            info=os.fstat(source.fileno())
            if not stat.S_ISREG(info.st_mode) or info.st_size>4096:
                raise RuntimeError('test request must be a bounded regular JSON file')
            raw=source.read(4097)
            if len(raw)!=info.st_size:raise RuntimeError('test request changed or exceeded its read bound')
        def unique_fields(pairs):
            value={}
            for key,item in pairs:
                if key in value:raise RuntimeError('test request contains duplicate fields')
                value[key]=item
            return value
        request=json.loads(raw,object_pairs_hook=unique_fields)
        allowed=({'schema','test_proton'},{'schema','test_proton','test_ipega'})
        if (not isinstance(request,dict) or set(request) not in allowed or
                request['schema']!='surface-vm-test-options-v1' or type(request['test_proton']) is not bool or
                ('test_ipega' in request and type(request['test_ipega']) is not bool)):
            raise RuntimeError('test request has an unknown schema, extra commands or non-boolean flag')
        return {'test_proton':request['test_proton'],'test_ipega':request.get('test_ipega',False)}
    finally:os.close(directory)


def proton_requested():return vm_test_options()['test_proton']
def ipega_requested():return vm_test_options()['test_ipega']


def ipega_check(run):
    guard()
    if not ipega_requested():raise RuntimeError('iPega probe requires an explicit read-only VM test request')
    environment=dict(os.environ,SDL_VIDEO_DRIVER='dummy',SDL_VIDEODRIVER='dummy',
                     SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS='1',SURFACE_VM_IPEGA_TEST='1')
    nodes=[node for node in Path('/sys/class/input').glob('event*')
           if (node/'device/name').read_text().strip()=='PG-9023S Keyboard' and
           (node/'device/id/vendor').read_text().strip()=='1949' and
           (node/'device/id/product').read_text().strip()=='0402']
    if len(nodes)!=1:raise RuntimeError('Expected exactly one synthetic iPega kernel input device')
    node=nodes[0]
    override=Path('/run/udev/rules.d/72-surface-gamepad.rules')
    override.parent.mkdir(exist_ok=True,parents=True)
    # Reproduce the previous rule on the exact same kernel device first.
    # Bind the previous rule over the packaged file only in this requested VM.
    # /etc takes priority over /run for files with the same name.
    legacy=Path('/etc/udev/rules.d/72-surface-gamepad.rules').read_text().replace(
        'KERNEL=="event[0-9]*", ATTRS{id/vendor}=="1949",',
        'KERNEL=="event[0-9]*", ENV{ID_INPUT_JOYSTICK}!="1", ENV{ID_INPUT_KEYBOARD}=="1", ATTRS{id/vendor}=="1949",')
    def reclassify(label):
        subprocess.run(['udevadm','control','--reload-rules'],check=True,timeout=5)
        subprocess.run(['udevadm','trigger','--action=add',str(node)],check=True,timeout=5)
        subprocess.run(['udevadm','settle','--timeout=5'],check=True,timeout=6)
        properties=subprocess.check_output(['udevadm','info','--query=property','--path='+str(node)],text=True,timeout=5)
        (run/('ipega-'+label+'-udev.log')).write_text(properties)
        return dict(line.split('=',1) for line in properties.splitlines() if '=' in line)
    descriptor=os.open(override,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600)
    bound=False
    try:
        with os.fdopen(descriptor,'w') as output:output.write(legacy)
        subprocess.run(['mount','--bind',str(override),'/etc/udev/rules.d/72-surface-gamepad.rules'],check=True,timeout=5)
        bound=True
        properties=reclassify('previous')
        if properties.get('ID_INPUT_JOYSTICK')!='1' or properties.get('ID_INPUT_KEYBOARD')!='1':
            raise RuntimeError('The synthetic HID did not reproduce mixed keyboard/gamepad classification')
        code,output=command(['/usr/bin/surface-controller-setup','--vm-ipega-probe'],
                            run/'ipega-previous-sdl.log',timeout=15,env=environment,tail=True,user='gaming')
        if code==0 or 'reason=not-enumerated-by-SDL' not in output:
            raise RuntimeError('The previous controller permissions bug was not reproduced')
        emit('SURFACE_IPEGA_REGRESSION_REPRODUCED',reason='mixed_keyboard_joystick_denied_to_gaming')
    finally:
        if bound:subprocess.run(['umount','/etc/udev/rules.d/72-surface-gamepad.rules'],check=True,timeout=5)
        override.unlink(missing_ok=True)
        properties=reclassify('corrected')
    if properties.get('ID_INPUT_JOYSTICK')!='1' or properties.get('ID_INPUT_KEYBOARD')!='0':
        raise RuntimeError('The packaged correction did not reclassify the mixed-mode controller')
    emit('SURFACE_IPEGA_PROBE_READY')
    code,output=command(['/usr/bin/surface-controller-setup','--vm-ipega-probe'],
                        run/'ipega-sdl-probe.log',timeout=15,env=environment,tail=True,user='gaming')
    print(output,flush=True)
    if code!=0 or 'SURFACE_IPEGA_DEVICE ' not in output or 'SURFACE_IPEGA_INPUT_PASS ' not in output:
        raise RuntimeError('Fake iPega did not enumerate, open as the gaming user, map by default and deliver its button input; inspect ipega-sdl-probe.log')
    account=pwd.getpwnam('gaming')
    work=Path(tempfile.mkdtemp(prefix='ipega-vm-',dir='/data'))
    os.chown(work,account.pw_uid,account.pw_gid)
    emulator=['/usr/bin/surface-emulator','--core','/usr/lib/libretro/fceumm_libretro.so',
              '--rom','/usr/share/surface-tests/input.nes','--system-dir',str(work),
              '--windowed','--no-audio','--frames','180']
    for label in ('baseline','controller'):
        if label=='controller':emit('SURFACE_IPEGA_EMULATOR_READY')
        code,output=command(emulator+['--save-dir',str(work/label),'--screenshot',str(work/(label+'.bmp'))],
                            run/('ipega-emulator-'+label+'.log'),timeout=15,env=environment,tail=True,user='gaming')
        if code!=0:raise RuntimeError('Unprivileged emulator failed its iPega input test: '+output[-512:])
    if (work/'baseline.bmp').read_bytes()==(work/'controller.bmp').read_bytes():
        raise RuntimeError('Actual iPega input did not change the real NES core framebuffer')
    emit('SURFACE_IPEGA_EMULATOR_INPUT_PASS',synthetic_input=False)
    return {'status':'PASS','mode':'QEMU virtio-input-host fake Bluetooth HID through guest udev, unprivileged SDL and default gamepad mapping',
            'input_log':str(run/'ipega-sdl-probe.log'),'previous_rule_failure_reproduced':True,
            'real_core_framebuffer_changed':True,'work_directory':str(work)}


def last_event(output):
    lines=[line for line in output.splitlines() if line.strip()]
    if not lines:raise RuntimeError('runner returned no JSON completion')
    value=json.loads(lines[-1])
    if not isinstance(value,dict):raise RuntimeError('runner completion is not a JSON object')
    return value


def selected_components(value,requested):
    components=value.split(',')
    if requested:
        components=[component for component in components if component!='proton']
        if 'browser' not in components:components.append('browser')
        components.append('proton')
    return components


def proton_check(run):
    guard()  # Also guard direct calls; --components never authorizes downloads.
    if not proton_requested():raise RuntimeError('Proton acceptance requires an explicit read-only test-VM request')
    capacity=shutil.disk_usage('/data')
    if capacity.total<=6*1024**3 or capacity.free<6*1024**3:
        raise RuntimeError('Proton acceptance requires installed DATA larger than 6 GiB and at least 6 GiB free; no download started')
    code,output=command(['/usr/bin/surface-windows-runner','--setup-proton'],run/'proton-setup.log',timeout=1500,tail=True)
    complete=last_event(output)
    if code!=0 or complete.get('event')!='complete':
        raise RuntimeError('Proton setup did not exit successfully with its final complete event; inspect proton-setup.log')
    code,output=command(['/usr/bin/surface-windows-runner','--status'],run/'proton-status.log',timeout=15)
    state=last_event(output)
    proton=state.get('proton')
    if code!=0 or state.get('event')!='windows-status' or state.get('proton_ready') is not True or state.get('gameplay_verified') is not False or not isinstance(proton,dict):
        raise RuntimeError('Read-only Windows runner status did not confirm the real Proton probe receipt')
    fields=('proton_path','runtime','manifest_sha256','version')
    if any(not isinstance(proton.get(key),str) or not proton[key] or proton[key]!=complete.get(key) for key in fields):
        raise RuntimeError('Proton completion and read-only status metadata disagree')
    return {'status':'PASS','requested':True,'mode':'explicit UMU Proton/runtime setup and unprivileged Windows command exit',
            'exit_code':0,'proton_ready':True,'proton':{key:proton[key] for key in fields},
            'gameplay_verified':False,'setup_log':str(run/'proton-setup.log')}


def private_mode(path,directory=False):
    info=path.lstat()
    if stat.S_ISLNK(info.st_mode) or (directory and not stat.S_ISDIR(info.st_mode)) or (not directory and not stat.S_ISREG(info.st_mode)):
        raise RuntimeError('persistent state has an unexpected file type')
    if info.st_uid!=os.geteuid() or info.st_mode&0o077:
        raise RuntimeError('persistent state is not private to its owner')


def inspect_state(state_path,checkpoint,boot_id):
    private_mode(state_path.parent,directory=True);private_mode(state_path)
    if state_path.stat().st_size>4*1024*1024:raise RuntimeError('state file exceeds acceptance read bound')
    raw=state_path.read_bytes();value=json.loads(raw)
    if not isinstance(value,dict):raise RuntimeError('state file is not a JSON store')
    # The upstream FileStore uses _machinekey. Keep only a digest in a private
    # checkpoint; never copy machine keys, profile data or auth URLs into logs.
    machine=value.get('_machinekey')
    fingerprint=hashlib.sha256(machine.encode()).hexdigest() if isinstance(machine,str) else None
    digest=hashlib.sha256(json.dumps(value,sort_keys=True,separators=(',',':')).encode()).hexdigest()
    previous=json.loads(checkpoint.read_text()) if checkpoint.is_file() else None
    outcome='first_boot'
    if previous:
        if previous.get('boot_id')==boot_id:outcome='same_boot'
        elif previous.get('machine_digest') and fingerprint:
            if previous['machine_digest']!=fingerprint:raise RuntimeError('persistent machine identity changed across boots')
            outcome='identity_persisted'
        elif previous.get('store_digest')==digest:outcome='store_persisted'
        else:outcome='state_updated_unverified'
    private_json(checkpoint,{'boot_id':boot_id,'machine_digest':fingerprint,'store_digest':digest})
    return {'outcome':outcome,'file_sha256':hashlib.sha256(raw).hexdigest()}


class PageServer(http.server.ThreadingHTTPServer):
    daemon_threads=True
    def __init__(self,nonce):
        super().__init__(('127.0.0.1',0),PageHandler)
        self.nonce=nonce;self.page_requested=threading.Event();self.rendered=threading.Event()
        self.tls_success=threading.Event();self.tls_failure=threading.Event()
        self.geometry_condition=threading.Condition();self.geometries=collections.deque(maxlen=64)


class PageHandler(http.server.BaseHTTPRequestHandler):
    def log_message(self,*_args):pass
    def do_GET(self):
        uri=urllib.parse.urlsplit(self.path)
        query=urllib.parse.parse_qs(uri.query)
        if query.get('token')!=[self.server.nonce]:
            self.send_error(403);return
        if uri.path=='/rendered':
            self.server.rendered.set();self.send_response(204);self.end_headers();return
        if uri.path=='/geometry':
            fields=('width','height','screen_width','screen_height')
            if set(query)!={'token',*fields} or any(len(query.get(key,[]))!=1 or
                not re.fullmatch(r'[1-9][0-9]{0,4}',query[key][0]) or int(query[key][0])>16384 for key in fields):
                self.send_error(400);return
            value={key:int(query[key][0]) for key in fields};value['at']=time.monotonic()
            with self.server.geometry_condition:
                self.server.geometries.append(value);self.server.geometry_condition.notify_all()
            self.send_response(204);self.end_headers();return
        if uri.path in ('/tls-success','/tls-failure'):
            event=self.server.tls_success if uri.path=='/tls-success' else self.server.tls_failure
            event.set();self.send_response(204);self.end_headers();return
        if uri.path!='/acceptance':self.send_error(404);return
        self.server.page_requested.set()
        page=('''<!doctype html><meta charset="utf-8"><title>403 OS Browser Acceptance</title>
<style>html{height:100%;background:#101b34;color:#f4f7ff;font:30px sans-serif}body{margin:8vh 8vw}
article{padding:5vw;border-radius:28px;background:#162b42;border:4px solid #63e6ab}h1{font-size:56px;color:#63e6ab}
p{line-height:1.5}.tag{font-size:24px;color:#8dcaf9}</style>
<article><div class="tag">403 OS / LIVE WEBKIT TEST</div><h1>Browser is running</h1>
<p>This page was served over the guest's local network.</p><p id="state">Waiting for the first rendered frame…</p>
<p id="tls">Checking HTTPS with certificate validation…</p>
<p>The test will close this browser and return to HOME.</p></article>
<script>
const reportGeometry=()=>requestAnimationFrame(()=>requestAnimationFrame(()=>{
 fetch('/geometry?token='''+self.server.nonce+'''&width='+innerWidth+'&height='+innerHeight+
  '&screen_width='+screen.width+'&screen_height='+screen.height,{cache:'no-store'});
}));
window.addEventListener('resize',reportGeometry);setInterval(reportGeometry,400);reportGeometry();
requestAnimationFrame(()=>requestAnimationFrame(()=>{
 document.getElementById('state').textContent='JavaScript and frame callbacks are working.';
 fetch('/rendered?token='''+self.server.nonce+'''',{cache:'no-store'});
 fetch('https://buildroot.org/',{mode:'no-cors',cache:'no-store',credentials:'omit',referrerPolicy:'no-referrer'}).then(()=>{
  document.getElementById('tls').textContent='HTTPS connected with certificate validation enabled.';
  return fetch('/tls-success?token='''+self.server.nonce+'''',{cache:'no-store'});
 },()=>{
  document.getElementById('tls').textContent='HTTPS failed. Certificate validation remains enabled.';
  return fetch('/tls-failure?token='''+self.server.nonce+'''',{cache:'no-store'});
 });
}));</script>''').encode()
        self.send_response(200);self.send_header('Content-Type','text/html; charset=utf-8')
        self.send_header('Cache-Control','no-store');self.send_header('Content-Length',str(len(page)))
        self.end_headers();self.wfile.write(page)


def wayland_committed(log):
    try:text=log.read_text(errors='replace')[-2*1024*1024:]
    except OSError:return False
    return 'wl_surface' in text and '.commit(' in text and ('xdg_surface' in text or 'xdg_toplevel' in text)


def process_identity(pid,name):
    if type(pid) is not int or pid<=0:raise RuntimeError('Rotation probe received an invalid process ID')
    node=Path('/proc')/str(pid)
    text=(node/'stat').read_text()
    if len(text)>8192 or ')' not in text:raise RuntimeError('Process identity is unavailable')
    fields=text[text.rfind(')')+1:].split()
    if len(fields)<20 or fields[0]=='Z' or not fields[19].isdigit() or (node/'exe').resolve().name!=name:
        raise RuntimeError('The expected live '+name+' process is unavailable')
    return dict(pid=pid,start_ticks=int(fields[19]),executable=name)



def browser_process(process,proc=Path('/proc')):
    """Identify Cog inside this launch's own dbus-run-session process group."""
    if process.poll() is not None:raise RuntimeError('Browser launcher has already exited')
    candidates=[]
    nodes=list(proc.iterdir())
    if len(nodes)>8192:raise RuntimeError('Process inventory exceeded the rotation probe bound')
    for node in nodes:
        if not node.name.isdigit():continue
        try:
            text=(node/'stat').read_text();fields=text[text.rfind(')')+1:].split()
            if (len(fields)>=20 and fields[0]!='Z' and fields[2:4]==[str(process.pid)]*2 and
                    (node/'exe').resolve(strict=True).name=='cog'):
                candidates.append(int(node.name))
        except (OSError,ValueError):continue
    if len(candidates)!=1:raise RuntimeError('Expected one live Cog in the browser launcher process group')
    return candidates[0]


def display_state_snapshot():
    result={}
    for path in DISPLAY_STATE:
        try:descriptor=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_CLOEXEC|os.O_NONBLOCK)
        except FileNotFoundError:result[str(path)]=None;continue
        with os.fdopen(descriptor,'rb') as stream:
            info=os.fstat(stream.fileno())
            if not stat.S_ISREG(info.st_mode) or info.st_size>4096:raise RuntimeError('Display configuration is not a bounded regular file')
            raw=stream.read(4097)
            if len(raw)!=info.st_size:raise RuntimeError('Display configuration changed during the probe snapshot')
        result[str(path)]=dict(sha256=hashlib.sha256(raw).hexdigest(),inode=info.st_ino,mtime_ns=info.st_mtime_ns,mode=info.st_mode)
    return result


def vm_rotation_output(root=Path('/sys/class/drm')):
    names=[]
    for node in sorted(root.glob('card*-*')):
        match=re.fullmatch(r'card[0-9]+-([A-Za-z][A-Za-z0-9-]{0,63})',node.name)
        if match and (node/'status').read_text().strip()=='connected':names.append(match[1])
    if len(names)!=1:raise RuntimeError('Rotation acceptance requires exactly one connected VM display')
    return names[0]


def rotation_command(output,transform):
    # Both this caller and the native module grant virtual-output eligibility
    # only to the exact disposable VM, never to Surface hardware.
    if VM_DMI.read_text().strip()!=VM_NAME or not ROTATION_MODULE.is_file():
        raise RuntimeError('Live rotation acceptance is restricted to the disposable VM with its real module')
    if not re.fullmatch(r'[A-Za-z][A-Za-z0-9-]{0,63}',output) or transform not in ('normal','90'):
        raise RuntimeError('Invalid rotation acceptance request')
    info=ROTATION_SOCKET.lstat()
    if not stat.S_ISSOCK(info.st_mode) or info.st_uid!=0 or info.st_mode&0o077:
        raise RuntimeError('The live compositor rotation socket is not root private')
    with socket.socket(socket.AF_UNIX,socket.SOCK_SEQPACKET) as client:
        client.settimeout(2);client.connect(str(ROTATION_SOCKET))
        pid,uid,_gid=struct.unpack('3i',client.getsockopt(socket.SOL_SOCKET,socket.SO_PEERCRED,12))
        if uid!=0:raise RuntimeError('Rotation acceptance is not connected to the root compositor')
        identity=process_identity(pid,'weston')
        client.sendall(f'{output} {transform}'.encode('ascii'));reply=client.recv(256)
    if reply!=b'OK':raise RuntimeError('The native compositor rejected rotation: '+reply.decode(errors='replace')[:160])
    return identity


def wait_browser_geometry(server,process,since,expected=None,timeout=8):
    deadline=time.monotonic()+timeout
    while time.monotonic()<deadline:
        if process.poll() is not None:raise RuntimeError('The real browser exited during live rotation')
        with server.geometry_condition:
            samples=[value for value in server.geometries if value['at']>=since]
            if len(samples)>=2:
                first,last=samples[-2:]
                shape=(last['width'],last['height'])
                if ((first['width'],first['height'])==shape and last['at']-first['at']>=.1 and
                        (expected is None or shape==expected)):
                    return {key:last[key] for key in ('width','height','screen_width','screen_height')}
            server.geometry_condition.wait(timeout=min(.1,max(0,deadline-time.monotonic())))
    raise RuntimeError('The live Wayland browser did not report the expected stable logical geometry')


def rotation_runtime_check(server,process,run):
    guard()
    if VM_DMI.read_text().strip()!=VM_NAME:
        return dict(status='NOT_RUN',reason='Rotation acceptance is restricted to the disposable VM')
    if not ROTATION_MODULE.is_file():raise RuntimeError('The real Weston rotation module is missing from this test image')
    before=display_state_snapshot();output=vm_rotation_output()
    browser=process_identity(browser_process(process),'cog');baseline=wait_browser_geometry(server,process,time.monotonic())
    if baseline['width']==baseline['height']:raise RuntimeError('A square viewport cannot prove a 90-degree output transform')
    compositor=None;changed=False;rotated=restored=None
    try:
        changed=True;since=time.monotonic();compositor=rotation_command(output,'90')
        rotated=wait_browser_geometry(server,process,since,(baseline['height'],baseline['width']))
        if process_identity(browser['pid'],'cog')!=browser or process_identity(compositor['pid'],'weston')!=compositor:
            raise RuntimeError('The compositor or browser process changed during rotation')
    finally:
        if changed:
            since=time.monotonic();restoring_compositor=rotation_command(output,'normal')
            restored=wait_browser_geometry(server,process,since,(baseline['width'],baseline['height']))
            if compositor is not None and restoring_compositor!=compositor:
                raise RuntimeError('The compositor was restarted before restoring native orientation')
    if process_identity(browser['pid'],'cog')!=browser or process_identity(compositor['pid'],'weston')!=compositor:
        raise RuntimeError('The compositor or browser process changed after restoring native orientation')
    if display_state_snapshot()!=before:raise RuntimeError('Live rotation modified a saved resolution, pending trial or preference')
    result=dict(status='PASS',mode='live Weston module with the real Wayland WebKit client',output=output,
                baseline=baseline,rotated=rotated,restored=restored,compositor=compositor,browser=browser,
                compositor_restarted=False,browser_restarted=False,resolution_state_unchanged=True,
                physical_accelerometer='UNVERIFIED: this VM probe does not supply sensor readings')
    private_json(run/'rotation.json',result)
    emit('SURFACE_ROTATION_RUNTIME_PASS',output=output,logical_size=f"{baseline['width']}x{baseline['height']}",
         rotated=f"{rotated['width']}x{rotated['height']}",restored=f"{restored['width']}x{restored['height']}",
         weston_pid=compositor['pid'],browser_pid=browser['pid'],processes='preserved',resolution_state='unchanged')
    return result


def browser_check(run,hold):
    runtime=Path(os.environ.get('XDG_RUNTIME_DIR','/run/surface'))
    display=Path(os.environ.get('WAYLAND_DISPLAY','wayland-0'))
    socket_path=display if display.is_absolute() else runtime/display
    if not socket_path.is_socket():raise RuntimeError('the compositor Wayland socket is unavailable')
    if not Path('/usr/bin/cog').is_file() or not Path('/usr/bin/surface-browser').is_file():
        raise RuntimeError('the real WebKit browser is not installed')
    server=PageServer(secrets.token_hex(16));worker=threading.Thread(target=server.serve_forever,daemon=True);worker.start()
    log=run/'browser.log';process=None;ready=False;started=time.monotonic()
    env=dict(os.environ,WAYLAND_DEBUG='client')
    url=f'http://127.0.0.1:{server.server_port}/acceptance?token={server.nonce}'
    try:
        with log.open('wb') as output:
            process=subprocess.Popen(['/usr/bin/surface-browser',url],stdin=subprocess.DEVNULL,
                                     stdout=output,stderr=subprocess.STDOUT,env=env,start_new_session=True)
            while time.monotonic()-started<50:
                if process.poll() is not None:raise RuntimeError(f'browser exited before readiness ({process.returncode})')
                if log.stat().st_size>8*1024*1024:raise RuntimeError('browser diagnostics exceeded their bounded log size')
                if server.tls_failure.is_set():raise RuntimeError('browser HTTPS request to https://buildroot.org/ failed with certificate validation enabled')
                if server.page_requested.is_set() and server.rendered.is_set() and server.tls_success.is_set() and wayland_committed(log) and time.monotonic()-started>=5:
                    ready=True;break
                time.sleep(.1)
            if not ready:raise RuntimeError('browser did not prove HTTP, JavaScript, CA-validated HTTPS and Wayland readiness before deadline')
            try:rotation=rotation_runtime_check(server,process,run)
            except (OSError,ValueError,RuntimeError) as error:
                emit('SURFACE_ROTATION_RUNTIME_FAIL',reason=error);raise
            emit('SURFACE_BROWSER_DISPLAY_READY',http='guest_loopback',javascript='frame_callback',https='buildroot.org_CA_validated',wayland='committed',hold_seconds=hold)
            until=time.monotonic()+hold
            while time.monotonic()<until:
                if process.poll() is not None:raise RuntimeError('browser exited during the screenshot interval')
                time.sleep(.1)
            emit('SURFACE_BROWSER_CLOSE_INPUT_READY',shortcut='Ctrl+W',deadline_seconds=15)
            try:code=process.wait(timeout=15)
            except subprocess.TimeoutExpired:
                raise RuntimeError('browser did not close through its Ctrl+W input path')
            if code!=0:raise RuntimeError(f'browser input close returned {code}')
        return {'status':'PASS','network':'local HTTP request and rendered JavaScript callback','wayland':'surface commit observed',
                'tls':{'status':'PASS','url':'https://buildroot.org/','mode':'browser fetch, no-cors','certificate_validation':True},
                'alive_seconds':round(time.monotonic()-started,1),'close_method':'Ctrl+W via keyboard input','exit_code':code,
                'rotation':rotation,
                'visual_verification':'host QMP screenshot required','log':str(log)}
    finally:
        if process is not None:stop_group(process)
        server.shutdown();server.server_close();worker.join(timeout=1)


def moonlight_check(run):
    executable=Path('/usr/bin/moonlight')
    if not executable.is_file():raise RuntimeError('Moonlight executable is not installed')
    env=dict(os.environ,HOME='/data/moonlight',SDL_VIDEODRIVER='wayland')
    code,output=command([str(executable),'help'],run/'moonlight.log',env=env)
    if code!=0 or 'Moonlight Embedded' not in output or 'Usage: moonlight' not in output:
        raise RuntimeError('Moonlight did not execute its real help/version path successfully')
    directory=Path('/data/moonlight');private_mode(directory,directory=True)
    return {'status':'PASS','mode':'real help/version process launch and exit','exit_code':code,
            'pairing_storage_private':True,'streaming':'BLOCKED: authorized Sunshine host and pairing required'}


def wine_check(run):
    cache_code,cache=command(['/sbin/ldconfig','-p'],run/'loader-cache.log')
    if cache_code!=0 or 'libc.so.6' not in cache or 'libGL.so.1' not in cache:
        raise RuntimeError('The host glibc/OpenGL loader cache required by UMU is unavailable')
    code,output=command(['/usr/bin/surface-windows-runner','--probe-wine'],run/'wine.log',timeout=75)
    events=[]
    for line in output.splitlines():
        try:events.append(json.loads(line))
        except ValueError:pass
    probe=next((item for item in events if isinstance(item,dict) and item.get('event')=='wine-probe'),{})
    if code!=0 or probe.get('exit')!=0 or probe.get('success') is not True or probe.get('gameplay_verified') is not False:
        raise RuntimeError('Wine did not pass the real unprivileged Windows command probe; inspect wine.log')
    return {'status':'PASS','mode':'unprivileged Wine64 Windows cmd.exe launch and exit',
            'exit_code':code,'gameplay_verified':False}


def policy_table_names():
    names={'unspec':0,'default':253,'main':254,'local':255}
    files=[Path('/etc/iproute2/rt_tables')]
    directory=Path('/etc/iproute2/rt_tables.d')
    if directory.is_dir():
        extra=sorted(directory.glob('*.conf'))
        if len(extra)>64:raise RuntimeError('routing table name inventory exceeds its bound')
        files+=extra
    for path in files:
        if not path.is_file():continue
        if path.stat().st_size>65536:raise RuntimeError('routing table names exceed their read bound')
        for line in path.read_text().splitlines():
            fields=line.split('#',1)[0].split()
            if not fields:continue
            if len(fields)!=2 or not fields[0].isdecimal():raise RuntimeError('routing table names are ambiguous')
            number=int(fields[0]);name=fields[1]
            if not 0<=number<=0xffffffff or (name in names and names[name]!=number):
                raise RuntimeError('routing table names conflict')
            names[name]=number
    return names


def policy_rules(output,names):
    if len(output)>=256*1024:raise RuntimeError('policy rule inventory exceeds its read bound')
    rules=[]
    for line in output.splitlines():
        if not line.strip():continue
        match=re.fullmatch(r'\s*(\d+):\s*(.+?)\s*',line)
        if not match:raise RuntimeError('policy rule output is ambiguous')
        priority=int(match[1]);body=match[2]
        tables=re.findall(r'(?:^|\s)(?:lookup|table)\s+(\S+)',body)
        if len(tables)>1:raise RuntimeError('policy lookup output is ambiguous')
        table=None
        if tables:
            token=tables[0]
            if token.isdecimal():table=int(token)
            elif re.fullmatch(r'0x[0-9a-fA-F]+',token):table=int(token,16)
            elif token in names:table=names[token]
            else:raise RuntimeError('policy lookup uses an unresolved table name')
        exact=re.fullmatch(r'from all(?: to all)? fwmark (0x[0-9a-fA-F]+|\d+)(?:/(0x[0-9a-fA-F]+|\d+))? (?:lookup|table) \S+',body)
        mark=mask=None
        if exact:
            mark=int(exact[1],16 if exact[1].startswith('0x') else 10)
            mask=int(exact[2],16 if exact[2] and exact[2].startswith('0x') else 10) if exact[2] else 0xffffffff
        rules.append(dict(priority=priority,table=table,mark=mark,mask=mask))
    return rules


def tailscale_policy_check(run):
    # This function can mutate temporary guest rules, so it guards itself even
    # when called directly rather than through the already guarded entrypoint.
    guard()
    names=policy_table_names();attempted=[];completed=[];failure=None;sequence=0
    deadline=time.monotonic()+12
    def ip(family,arguments,cleanup=False):
        nonlocal sequence
        sequence+=1
        timeout=2 if cleanup else min(2,max(0,deadline-time.monotonic()))
        if timeout<=0:raise RuntimeError('policy routing acceptance exceeded its deadline')
        log=run/f'policy-ipv{family}-{sequence}.log'
        return command(['/sbin/ip','-'+str(family),*arguments],log,timeout=timeout,
                       env=dict(os.environ,LC_ALL='C'))
    def rules(family,cleanup=False):
        code,output=ip(family,['rule','show'],cleanup)
        if code!=0:raise RuntimeError(f'IPv{family} policy rule listing failed')
        return policy_rules(output,names)
    def free(spec,inventory):
        return not any(rule['priority']==spec['priority'] or rule['table']==spec['table'] for rule in inventory)
    def identity(spec,rule):
        return (rule['priority'],rule['table'],rule['mark'],rule['mask'])==(spec['priority'],spec['table'],spec['mark'],0xffffffff)
    def selectors(spec):
        return ['priority',str(spec['priority']),'from','all','fwmark',hex(spec['mark'])+'/0xffffffff','lookup',str(spec['table'])]
    def empty_table(family,table):
        code,output=ip(family,['route','show','table',str(table)])
        if code==2 and 'FIB table does not exist' in output:return True
        if code!=0:raise RuntimeError(f'IPv{family} lookup table inspection failed')
        return not output.strip()
    try:
        inventories={family:rules(family) for family in (4,6)}
        chosen=None
        for offset in range(16):
            spec=dict(priority=52000+offset,table=180+offset,mark=0x40300000|secrets.randbits(20))
            if spec['table'] in names.values() or any(not free(spec,inventory) for inventory in inventories.values()):continue
            empty=True
            for family in (4,6):
                if not empty_table(family,spec['table']):empty=False;break
            if not empty:continue
            # Recheck both families immediately before adding. Existing rules
            # and named/occupied tables are never removed or reused by this test.
            inventories={family:rules(family) for family in (4,6)}
            if any(not free(spec,inventory) for inventory in inventories.values()):continue
            chosen=spec;break
        if chosen is None:raise RuntimeError('no unused policy-rule priority and lookup table were available')
        for family in (4,6):
            inventory=rules(family)
            if not free(chosen,inventory) or not empty_table(family,chosen['table']):
                raise RuntimeError('policy-rule priority or lookup table became occupied')
            spec=dict(chosen,family=family)
            # The randomized identity was absent immediately before this attempt.
            # Track attempts before invocation so a timed-out add is cleaned too.
            attempted.append(spec)
            code,_=ip(family,['rule','add',*selectors(spec)])
            if code!=0:raise RuntimeError(f'IPv{family} policy rule add failed')
            inventory=rules(family)
            matching=[rule for rule in inventory if identity(spec,rule)]
            collisions=[rule for rule in inventory if (rule['priority']==spec['priority'] or rule['table']==spec['table']) and not identity(spec,rule)]
            if len(matching)!=1 or collisions:raise RuntimeError(f'IPv{family} policy rule readback did not match the temporary rule')
            completed.append(family)
    except (OSError,ValueError,RuntimeError,subprocess.SubprocessError) as error:
        failure=str(error)
    finally:
        cleanup_errors=[]
        for spec in reversed(attempted):
            issue=None
            for _attempt in range(2):
                try:
                    # Always specify priority, source, randomized full-mask mark
                    # and lookup table. Never flush/delete by priority alone.
                    code,_=ip(spec['family'],['rule','del',*selectors(spec)],cleanup=True)
                    remaining=rules(spec['family'],cleanup=True)
                    if any(identity(spec,rule) for rule in remaining):
                        raise RuntimeError('the exact temporary rule remains after delete')
                    if code!=0 and spec['family'] in completed:
                        raise RuntimeError('temporary rule delete returned a failure')
                    break
                except (OSError,ValueError,RuntimeError,subprocess.SubprocessError) as error:
                    issue=str(error)
            if issue:cleanup_errors.append(f'IPv{spec["family"]}: {issue}')
        if cleanup_errors:
            failure=(failure+'; ' if failure else '')+'temporary policy-rule cleanup failed: '+'; '.join(cleanup_errors)
    if failure:raise RuntimeError(failure)
    if completed!=[4,6]:raise RuntimeError('both policy-rule families were not verified')
    emit('SURFACE_TAILSCALE_POLICY_ROUTING_PASS',families='ipv4,ipv6',temporary_rules='removed')
    return {'status':'PASS','families':['ipv4','ipv6'],'operation':'temporary fwmark lookup add/read/delete',
            'temporary_rules_removed':True,'enrollment_verified':False}


def tailscale_check(run,boot_id):
    policy=tailscale_policy_check(run)
    pid_file=Path('/run/tailscale/tailscaled.pid');socket_path=Path('/run/tailscale/tailscaled.sock')
    if not socket_path.is_socket():
        code,_=command(['/etc/init.d/S71tailscaled','start'],run/'tailscale-start.log')
        if code!=0:raise RuntimeError('tailscaled service did not start')
    deadline=time.monotonic()+8
    while not socket_path.is_socket() and time.monotonic()<deadline:time.sleep(.1)
    if not socket_path.is_socket() or not pid_file.is_file():raise RuntimeError('tailscaled PID or local socket is missing')
    pid=int(pid_file.read_text().strip());argv=Path(f'/proc/{pid}/cmdline').read_bytes().split(b'\0')
    if b'--state=/data/tailscale/tailscaled.state' not in argv or b'--statedir=/data/tailscale' not in argv:
        raise RuntimeError('tailscaled is not using the private persistent state store')
    # stdout may contain user identifiers. Keep it in memory and store only the
    # sanitized backend state in the acceptance report, never raw status JSON.
    process=subprocess.Popen(['/usr/bin/tailscale','status','--json'],stdin=subprocess.DEVNULL,
                             stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,start_new_session=True)
    try:output,_=process.communicate(timeout=8)
    except subprocess.TimeoutExpired:stop_group(process);raise RuntimeError('tailscale status command timed out')
    if len(output)>2*1024*1024:raise RuntimeError('tailscale status exceeded acceptance read bound')
    value=json.loads(output);backend=value.get('BackendState')
    if backend not in ALLOWED_BACKENDS:raise RuntimeError('tailscale local API returned no recognized backend state')
    state=inspect_state(STATE_FILE,Path('/data/app-acceptance/tailscale-checkpoint.json'),boot_id)
    outcome=state['outcome']
    print('SURFACE_TAILSCALE_STATE_SHA256='+state['file_sha256'],flush=True)
    emit('SURFACE_TAILSCALED_STARTUP_PASS',backend=backend,persistent_state='configured',private='yes')
    if outcome in ('identity_persisted','store_persisted'):
        emit('SURFACE_TAILSCALE_STATE_PERSISTENCE_PASS',verification=outcome)
    else:emit('SURFACE_TAILSCALE_STATE_PERSISTENCE_NOT_VERIFIED',reason=outcome)
    return {'status':'PASS','backend':backend,'state_file_private':True,'persistence':outcome,'state_sha256':state['file_sha256'],'policy_routing':policy,
            'enrollment':'BLOCKED: explicit isolated test-tailnet authorization required'}


def write_sine(path):
    rate=48000;frames=rate
    with wave.open(str(path),'wb') as output:
        output.setnchannels(2);output.setsampwidth(2);output.setframerate(rate)
        samples=bytearray()
        for i in range(frames):
            sample=int(4096*math.sin(2*math.pi*440*i/rate));samples+=struct.pack('<hh',sample,sample)
        output.writeframes(samples)
    return frames


def audio_check(run):
    guard()
    if not Path('/usr/bin/aplay').is_file():raise RuntimeError('ALSA aplay is not installed')
    mixer=shutil.which('amixer')
    if not mixer:raise RuntimeError('ALSA mixer diagnostics are not installed')
    code,_=command([mixer,'-c','0','contents'],run/'audio-mixer.log',timeout=3)
    if code!=0:raise RuntimeError('ALSA mixer diagnostics could not read the playback card')
    path=run/'audio-sine.wav';frames=write_sine(path)
    code,_=command(['/usr/bin/aplay','-q','-D','plughw:0,0',str(path)],run/'audio.log',timeout=8)
    if code!=0:raise RuntimeError('ALSA rejected the generated PCM test audio')
    return {'status':'PASS','mode':'ALSA accepted generated 440Hz stereo PCM','frames':frames,'sample_rate':48000,'device':'plughw:0,0',
            'mixer_log':str(run/'audio-mixer.log'),
            'audible_output':'UNVERIFIED: host QEMU audio capture or hardware listening test required'}


def installer_check(run):
    guard()
    if not INSTALLER_PAYLOAD.exists():
        emit('SURFACE_INSTALLER_PAYLOAD_NOT_PRESENT',scope='installed_system')
        return {'status':'PASS','mode':'installed system without USB installer payload'}
    code,output=command(['/usr/sbin/surface-install-device','--list'],run/'installer-discovery.log',timeout=30)
    if code!=0:raise RuntimeError('installer could not discover its embedded source')
    listing=last_event(output)
    sources=[value for value in listing.get('sources',[]) if value.get('path')==str(INSTALLER_PAYLOAD)]
    if listing.get('event')!='list' or len(sources)!=1:
        raise RuntimeError('installer did not discover exactly one embedded DATA source')
    source=sources[0];size=source.get('bytes');expected=source.get('sha256','')
    if type(size) is not int or not 64*1024**2<=size<=16*1024**3 or not re.fullmatch('[0-9a-f]{64}',expected):
        raise RuntimeError('embedded installer source has invalid size or checksum metadata')
    descriptor=os.open(INSTALLER_PAYLOAD,os.O_RDONLY|os.O_CLOEXEC|os.O_NOFOLLOW|os.O_NONBLOCK)
    with os.fdopen(descriptor,'rb') as stream:
        before=os.fstat(stream.fileno())
        if (not stat.S_ISREG(before.st_mode) or before.st_size!=size or before.st_ino!=source.get('inode')
                or before.st_mtime_ns!=source.get('mtime_ns')
                or f'{os.major(before.st_dev)}:{os.minor(before.st_dev)}'!=source.get('filesystem_devnum')):
            raise RuntimeError('embedded installer file changed after discovery')
        digest=hashlib.sha256();remaining=size
        while remaining:
            block=stream.read(min(4*1024**2,remaining))
            if not block:raise RuntimeError('embedded installer payload is truncated')
            digest.update(block);remaining-=len(block)
        after=os.fstat(stream.fileno())
        if stream.read(1) or (before.st_dev,before.st_ino,before.st_size,before.st_mtime_ns)!=(after.st_dev,after.st_ino,after.st_size,after.st_mtime_ns):
            raise RuntimeError('embedded installer payload changed during checksum verification')
    if digest.hexdigest()!=expected:raise RuntimeError('embedded installer payload checksum mismatch')
    emit('SURFACE_INSTALLER_PAYLOAD_VERIFIED',sha256=expected,bytes=size)
    return {'status':'PASS','mode':'embedded installer source discovered and full SHA256 verified',
            'sha256':expected,'bytes':size,'target_written':False}


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--components',default='installer,tailscale,moonlight,audio,wine,browser')
    parser.add_argument('--browser-hold',type=float,default=10)
    args=parser.parse_args()
    try:guard()
    except (OSError,RuntimeError) as error:
        emit('SURFACE_APP_CHECK_REFUSED',reason=error);return 2
    os.umask(0o077)
    boot_id=Path('/proc/sys/kernel/random/boot_id').read_text().strip()
    run=Path('/data/app-acceptance')/(time.strftime('%Y%m%dT%H%M%SZ',time.gmtime())+'-'+str(os.getpid()))
    run.mkdir(parents=True,mode=0o700)
    checks={'installer':lambda:installer_check(run),'tailscale':lambda:tailscale_check(run,boot_id),'moonlight':lambda:moonlight_check(run),'wine':lambda:wine_check(run),
            'audio':lambda:audio_check(run),'browser':lambda:browser_check(run,max(0,min(args.browser_hold,60))),
            'proton':lambda:proton_check(run),'ipega':lambda:ipega_check(run)}
    results={'boot_id':boot_id,'checks':{},'evidence_directory':str(run),'scope':'guest runtime; no Surface hardware, enrollment or streaming pass'}
    components=args.components.split(',')
    try:
        test_options=vm_test_options()
        requested=test_options['test_proton']
        requested_ipega=test_options['test_ipega']
        results['proton_requested']=requested
        results['ipega_requested']=requested_ipega
        emit('SURFACE_PROTON_REQUEST',requested=requested)
        emit('SURFACE_IPEGA_REQUEST',requested=requested_ipega)
        components=selected_components(args.components,requested)
        if requested_ipega:components.append('ipega')
    except (OSError,ValueError,RuntimeError) as error:
        results['proton_requested']=False
        results['checks']['proton']={'status':'FAIL','reason':str(error)}
        emit('SURFACE_PROTON_FAIL',reason=error)
        emit('SURFACE_IPEGA_FAIL',reason=error)
        components=[component for component in components if component!='proton']
    for component in components:
        if component not in checks:
            results['checks'][component]={'status':'FAIL','reason':'unknown requested check'};continue
        try:
            result=checks[component]();results['checks'][component]=result
            emit('SURFACE_'+component.upper()+'_PASS',scope=result.get('mode','bounded_runtime'))
        except (OSError,ValueError,RuntimeError,subprocess.SubprocessError) as error:
            results['checks'][component]={'status':'FAIL','reason':str(error)}
            emit('SURFACE_'+component.upper()+'_FAIL',reason=error)
        private_json(run/'result.json',results)
    private_json(Path('/data/app-acceptance/latest.json'),results)
    failed=any(value['status']=='FAIL' for value in results['checks'].values())
    emit('SURFACE_APP_CHECK_END',status='FAIL' if failed else 'PASS',results=run/'result.json')
    return 1 if failed else 0


if __name__=='__main__':raise SystemExit(main())
