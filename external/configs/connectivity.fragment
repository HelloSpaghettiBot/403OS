# Mandatory applications for the normal Surface image.
BR2_PACKAGE_SURFACE_TAILSCALE=y
BR2_PACKAGE_SURFACE_MOONLIGHT=y

# Moonlight Embedded's SDL frontend uses Wayland/EGL and software H.264/HEVC.
# Intel VAAPI acceleration is a separate hardware-validation task.
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_OPENGLES=y
BR2_PACKAGE_SDL2_WAYLAND=y
BR2_PACKAGE_FFMPEG=y
BR2_PACKAGE_FFMPEG_SWSCALE=y
BR2_PACKAGE_AVAHI=y
BR2_PACKAGE_AVAHI_DAEMON=y
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_OPUS=y
BR2_PACKAGE_LIBEVDEV=y
BR2_PACKAGE_UTIL_LINUX_LIBUUID=y

# Buildroot's pinned Cog0.18.5 + WPE2.50.5 stack, integrated into Weston.
# WPEBackend-fdo selects Mesa EGL_WL_bind_wayland_display support automatically.
BR2_PACKAGE_WPEWEBKIT=y
BR2_PACKAGE_WPEWEBKIT_SANDBOX=y
BR2_PACKAGE_WPEWEBKIT_MULTIMEDIA=y
BR2_PACKAGE_COG=y
BR2_PACKAGE_COG_PLATFORM_FDO=y
BR2_PACKAGE_COG_PROGRAMS_HOME_URI="https://www.google.com/"
BR2_PACKAGE_DEJAVU=y
