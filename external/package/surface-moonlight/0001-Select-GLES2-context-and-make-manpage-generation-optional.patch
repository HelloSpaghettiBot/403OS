From: Surface Go Gaming OS project <local@surface.invalid>
Subject: [PATCH] Select GLES2 for SDL and make manpage generation optional

The Surface image provides an EGL/GLES Wayland stack. Request GLES explicitly
instead of relying on SDL's desktop-OpenGL context defaults. Documentation is
optional so cross compilation does not depend on the host pod2man utility.

Upstream: project-specific GLES build configuration

--- a/src/sdl.c
+++ b/src/sdl.c
@@ -44,6 +44,9 @@
   }
 
   fullscreen_flags = fullscreen?SDL_WINDOW_FULLSCREEN:0;
+  SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_ES);
+  SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 2);
+  SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 0);
   window = SDL_CreateWindow("Moonlight", SDL_WINDOWPOS_UNDEFINED, SDL_WINDOWPOS_UNDEFINED, width, height, SDL_WINDOW_OPENGL | fullscreen_flags);
   if(!window) {
     fprintf(stderr, "SDL: could not create window - exiting\n");
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -226,7 +226,10 @@
 target_include_directories(moonlight PRIVATE ${GAMESTREAM_INCLUDE_DIR} ${MOONLIGHT_COMMON_INCLUDE_DIR} ${OPUS_INCLUDE_DIRS} ${EVDEV_INCLUDE_DIRS} ${UDEV_INCLUDE_DIRS})
 target_link_libraries(moonlight ${EVDEV_LIBRARIES} ${OPUS_LIBRARY} ${UDEV_LIBRARIES} ${CMAKE_DL_LIBS})
 
-add_subdirectory(docs)
+option(BUILD_DOCS "Build the manual with host pod2man" OFF)
+if (BUILD_DOCS)
+  add_subdirectory(docs)
+endif()
 
 install(TARGETS moonlight DESTINATION ${CMAKE_INSTALL_BINDIR})
 install(FILES ./third_party/SDL_GameControllerDB/gamecontrollerdb.txt DESTINATION ${CMAKE_INSTALL_DATADIR}/moonlight)
