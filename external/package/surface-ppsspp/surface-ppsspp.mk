SURFACE_PPSSPP_VERSION = 1.20.4
SURFACE_PPSSPP_SOURCE = ppsspp-$(SURFACE_PPSSPP_VERSION).tar.xz
SURFACE_PPSSPP_SITE = https://github.com/hrydgard/ppsspp/releases/download/v$(SURFACE_PPSSPP_VERSION)
SURFACE_PPSSPP_LICENSE = GPL-2.0+, BSD-3-Clause, MIT, Apache-2.0
SURFACE_PPSSPP_LICENSE_FILES = LICENSE.TXT
SURFACE_PPSSPP_DEPENDENCIES = libgles zlib libpng zstd ffmpeg libcurl host-pkgconf
SURFACE_PPSSPP_CONF_OPTS = -DLIBRETRO=ON -DUSING_GLES2=ON -DUSING_EGL=OFF \
    -DUSING_X11_VULKAN=OFF -DUSE_WAYLAND_WSI=OFF -DUSE_VULKAN_DISPLAY_KHR=OFF \
    -DHEADLESS=OFF -DUNITTEST=OFF -DATLAS_TOOL=OFF -DUSE_DISCORD=OFF \
    -DUSE_MINIUPNPC=OFF -DUSE_FFMPEG=ON -DUSE_SYSTEM_FFMPEG=ON \
    -DUSE_SYSTEM_LIBPNG=ON -DUSE_SYSTEM_ZSTD=ON -DUSE_CCACHE=OFF \
    -DCMAKE_POSITION_INDEPENDENT_CODE=ON -DBUILD_SHARED_LIBS=OFF

define SURFACE_PPSSPP_INSTALL_TARGET_CMDS
	$(INSTALL) -D -m 0755 $(@D)/lib/ppsspp_libretro.so $(TARGET_DIR)/usr/lib/libretro/ppsspp_libretro.so
	mkdir -p $(TARGET_DIR)/usr/share/surface/system/PPSSPP
	cp -a $(@D)/assets/. $(TARGET_DIR)/usr/share/surface/system/PPSSPP/
	$(INSTALL) -D -m 0644 $(@D)/LICENSE.TXT $(TARGET_DIR)/usr/share/licenses/surface-ppsspp/LICENSE.TXT
endef
$(eval $(cmake-package))
