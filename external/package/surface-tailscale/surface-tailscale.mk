################################################################################
# Official static release: avoids rebuilding a second Go toolchain for the image.
################################################################################
SURFACE_TAILSCALE_VERSION = 1.104.7
SURFACE_TAILSCALE_SITE = https://pkgs.tailscale.com/stable
SURFACE_TAILSCALE_SOURCE = tailscale_$(SURFACE_TAILSCALE_VERSION)_amd64.tgz
SURFACE_TAILSCALE_EXTRA_DOWNLOADS = https://raw.githubusercontent.com/tailscale/tailscale/v$(SURFACE_TAILSCALE_VERSION)/LICENSE
SURFACE_TAILSCALE_LICENSE = BSD-3-Clause
SURFACE_TAILSCALE_LICENSE_FILES = LICENSE
SURFACE_TAILSCALE_REDISTRIBUTE = YES
SURFACE_TAILSCALE_STRIP_COMPONENTS = 1
SURFACE_TAILSCALE_DEPENDENCIES = ca-certificates nftables

define SURFACE_TAILSCALE_COPY_LICENSE
	cp $(SURFACE_TAILSCALE_DL_DIR)/LICENSE $(@D)/LICENSE
endef
SURFACE_TAILSCALE_POST_EXTRACT_HOOKS += SURFACE_TAILSCALE_COPY_LICENSE

define SURFACE_TAILSCALE_INSTALL_TARGET_CMDS
	$(INSTALL) -D -m 0755 $(@D)/tailscale $(TARGET_DIR)/usr/bin/tailscale
	$(INSTALL) -D -m 0755 $(@D)/tailscaled $(TARGET_DIR)/usr/sbin/tailscaled
	$(INSTALL) -D -m 0644 $(@D)/LICENSE $(TARGET_DIR)/usr/share/licenses/tailscale/LICENSE
endef

define SURFACE_TAILSCALE_INSTALL_INIT_SYSV
	$(INSTALL) -D -m 0755 $(SURFACE_TAILSCALE_PKGDIR)/S71tailscaled $(TARGET_DIR)/etc/init.d/S71tailscaled
endef

define SURFACE_TAILSCALE_LINUX_CONFIG_FIXUPS
	$(call KCONFIG_ENABLE_OPT,CONFIG_TUN)
	$(call KCONFIG_ENABLE_OPT,CONFIG_IP_ADVANCED_ROUTER)
	$(call KCONFIG_ENABLE_OPT,CONFIG_IP_MULTIPLE_TABLES)
	$(call KCONFIG_ENABLE_OPT,CONFIG_IPV6)
	$(call KCONFIG_ENABLE_OPT,CONFIG_IPV6_MULTIPLE_TABLES)
	$(call KCONFIG_ENABLE_OPT,CONFIG_NETFILTER)
	$(call KCONFIG_ENABLE_OPT,CONFIG_NETFILTER_NETLINK)
	$(call KCONFIG_ENABLE_OPT,CONFIG_NF_CONNTRACK)
	$(call KCONFIG_ENABLE_OPT,CONFIG_NF_NAT)
	$(call KCONFIG_ENABLE_OPT,CONFIG_NF_TABLES)
	$(call KCONFIG_ENABLE_OPT,CONFIG_NF_TABLES_INET)
	$(call KCONFIG_ENABLE_OPT,CONFIG_NF_TABLES_IPV4)
	$(call KCONFIG_ENABLE_OPT,CONFIG_NF_TABLES_IPV6)
	$(call KCONFIG_ENABLE_OPT,CONFIG_NFT_CT)
	$(call KCONFIG_ENABLE_OPT,CONFIG_NFT_MASQ)
	$(call KCONFIG_ENABLE_OPT,CONFIG_NFT_NAT)
endef

$(eval $(generic-package))
