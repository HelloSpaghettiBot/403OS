# https://github.com/libretro/mgba
SURFACE_MGBA_VERSION = 7a12d6d4b9acb14c0ae62c9166b6a2f3d08007f6
SURFACE_MGBA_SITE = $(call github,libretro,mgba,$(SURFACE_MGBA_VERSION))
SURFACE_MGBA_LICENSE = MPL-2.0
SURFACE_MGBA_LICENSE_FILES = LICENSE
SURFACE_MGBA_CONF_OPTS = -DBUILD_LIBRETRO=ON -DLIBRETRO_LIBDIR=/usr/lib/libretro \
    -DBUILD_QT=OFF -DBUILD_SDL=OFF -DBUILD_GL=OFF -DBUILD_GLES2=OFF -DBUILD_GLES3=OFF \
    -DSKIP_LIBRARY=ON -DBUILD_SHARED=OFF -DBUILD_STATIC=OFF -DDISABLE_DEPS=ON \
    -DENABLE_SCRIPTING=OFF -DENABLE_DEBUGGERS=OFF -DENABLE_GDB_STUB=OFF \
    -DBUILD_TEST=OFF -DBUILD_SUITE=OFF -DBUILD_CINEMA=OFF -DBUILD_LTO=OFF

define SURFACE_MGBA_INSTALL_LICENSE
	$(INSTALL) -D -m 0644 $(@D)/LICENSE $(TARGET_DIR)/usr/share/licenses/surface-mgba/LICENSE
endef
SURFACE_MGBA_POST_INSTALL_TARGET_HOOKS += SURFACE_MGBA_INSTALL_LICENSE
$(eval $(cmake-package))
