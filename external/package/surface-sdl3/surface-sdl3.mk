SURFACE_SDL3_VERSION = 3.4.20
SURFACE_SDL3_SOURCE = SDL3-$(SURFACE_SDL3_VERSION).tar.gz
SURFACE_SDL3_SITE = https://www.libsdl.org/release
SURFACE_SDL3_LICENSE = Zlib
SURFACE_SDL3_LICENSE_FILES = LICENSE.txt
SURFACE_SDL3_INSTALL_STAGING = YES
SURFACE_SDL3_DEPENDENCIES = wayland wayland-protocols libxkbcommon udev libegl libgles
SURFACE_SDL3_CONF_OPTS = -DSDL_SHARED=ON -DSDL_STATIC=OFF -DSDL_TESTS=OFF \
    -DSDL_WAYLAND=ON -DSDL_WAYLAND_SHARED=OFF -DSDL_X11=OFF \
    -DSDL_OPENGL=OFF -DSDL_OPENGLES=ON -DSDL_VULKAN=OFF -DSDL_KMSDRM=OFF \
    -DSDL_DUMMYVIDEO=ON -DSDL_OFFSCREEN=ON -DSDL_LIBUDEV=ON \
    -DSDL_JOYSTICK_VIRTUAL=ON -DSDL_DBUS=OFF -DSDL_IBUS=OFF -DSDL_UNIX_CONSOLE_BUILD=ON
$(eval $(cmake-package))
